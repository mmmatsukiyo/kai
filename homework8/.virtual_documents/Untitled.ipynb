# 2 --- Matplotlib ---
import numpy as np
import matplotlib.pyplot as plt


# 2.1
def make_sine_wave(x, A, w):
    sin = np.sin(w*x)
    y = A * sin
    return y


# 2.2
arr = np.linspace(0, 2*np.pi, 1000)


